# ===========================================
# k-budget — variables d'environnement
# ===========================================
#
#   cp .env.example .env
#
# Deux valeurs seulement sont obligatoires : JWT_SECRET et DB_PASSWORD.
# Tout le reste a un defaut utilisable tel quel. Le fichier .env est ignore
# par git.


# ============ OBLIGATOIRE ============

# Cle de signature des jetons d'authentification. Generer une valeur unique :
#
#   openssl rand -base64 48
#
# L'API refuse de demarrer si cette variable est absente, trop courte, ou si
# elle vaut encore la valeur d'exemple ci-dessous. La changer plus tard
# invalide toutes les sessions en cours.
JWT_SECRET=CHANGEME-generer-avec-openssl-rand-base64-48

# Mot de passe de la base. Choisir une valeur unique avant le premier
# demarrage : elle est ecrite dans le volume PostgreSQL a l'initialisation et
# la modifier ensuite demande de recreer ce volume.
DB_PASSWORD=CHANGEME


# ============ OPTIONNEL ============

# --- Port d'ecoute du client web ---
# L'interface sera sur http://localhost:8080
APP_PORT=8080

# --- Base de donnees ---
# Le compose fournit PostgreSQL ; ces valeurs n'ont besoin d'etre changees que
# pour se connecter a une base externe existante.
DB_NAME=budget_db
DB_USERNAME=budget_u

# --- Administrateurs ---
# Emails promus administrateurs au demarrage, separes par des virgules.
# Peut rester vide : le premier compte cree par le projet est deja
# administrateur, et son mot de passe genere s'affiche dans les logs de l'API
# au tout premier lancement.
ADMIN_EMAILS=

# --- Origines CORS autorisees ---
# INUTILE avec le compose fourni : le client web proxifie /api/ vers l'API,
# le navigateur ne voit donc qu'une seule origine.
# A renseigner uniquement si le frontend est servi depuis un autre domaine que
# l'API. Origine exacte : schema + host + port, plusieurs valeurs separees par
# des virgules.
CORS_ALLOWED_ORIGINS=

# --- Compatibilite des clients (KKS-314) ---
# Version de client la plus ancienne acceptee, exposee par GET /api/meta. Un
# client plus ancien affiche un ecran explicite au lieu d'echouer sur une
# erreur technique. Ne bouge qu'a une rupture de contrat, pas a chaque release.
MIN_CLIENT_VERSION=6.0.0

# --- Limitation de debit sur l'authentification (KKS-310) ---
# Tentatives autorisees par fenetre et par IP sur /auth/login, /auth/refresh,
# /auth/accept-invite et /auth/invitations/{token}.
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_WINDOW_SECONDS=60

# Prefixes d'IP dont l'en-tete X-Forwarded-For est cru. Le defaut couvre les
# plages privees, donc le deploiement fourni. A completer si un reverse proxy
# est place devant sur un autre reseau : sinon toutes les requetes portent son
# IP et la limite s'applique a tout le monde ensemble.
#
# Ne jamais y mettre 0.0.0.0/ ni faire confiance a tout : l'en-tete est fourni
# par le client, le croire sans condition rend la limitation contournable.
TRUSTED_PROXIES=10.,172.16.,172.17.,172.18.,172.19.,172.2,172.3,192.168.,127.0.0.1
