# ===========================================
# K-Budget — Variables d'environnement
# ===========================================
# Copier ce fichier vers .env et remplacer les valeurs.
# Le fichier .env est ignore par git.

# --- Base de donnees PostgreSQL (VM separee) ---
DB_URL=jdbc:postgresql://POSTGRES_VM_IP:5432/budget_db
DB_USERNAME=budget_u
DB_PASSWORD=changeme

# --- JWT Secret (256 bits minimum) ---
JWT_SECRET=changeme-use-a-strong-random-secret
