# ===========================================
# K-Budget — Variables d'environnement
# ===========================================
# Copier ce fichier vers .env et remplacer les valeurs.
# Le fichier .env est ignore par git.

# --- Base de donnees PostgreSQL (VM separee) ---
DB_URL=jdbc:postgresql://POSTGRES_VM_IP:5432/budget_db
DB_USERNAME=budget_u
DB_PASSWORD=changeme

# --- JWT Secret (256 bits minimum) ---
JWT_SECRET=changeme-use-a-strong-random-secret

# --- Origines CORS autorisees ---
# Origine exacte depuis laquelle le frontend appelle l'API (schema + host + port).
# Sans cette variable, seul https://budget.kksdev.fr est accepte et le login
# echoue en 403 "Invalid CORS request". Plusieurs valeurs separees par des virgules.
CORS_ALLOWED_ORIGINS=https://budget.exemple.fr

# --- Emails administrateurs (separes par des virgules) ---
ADMIN_EMAILS=admin@exemple.fr

# --- Compatibilite des clients (KKS-314) ---
# Version de client la plus ancienne acceptee, exposee par GET /api/meta.
# Un client plus ancien affiche un ecran explicite au lieu d'echouer sur une
# erreur technique. Ne bouge qu'a une rupture de contrat, pas a chaque release.
MIN_CLIENT_VERSION=6.0.0

