{
  "name": "k-budget-app",
  "version": "6.15.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.{scss,ts}\" && node ../scripts/check-css-vars.mjs && node ../scripts/check-global-duplicates.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "~22.2.4",
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@angular/service-worker": "~22.2.4",
    "@emoji-mart/data": "^1.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@ng-icons/core": "^33.1.0",
    "@ng-icons/phosphor-icons": "^33.1.0",
    "@stomp/stompjs": "^7.3.0",
    "chart.js": "^4.5.1",
    "emoji-mart": "^5.6.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@angular/platform-browser-dynamic": "~22.2.4",
    "@messageformat/parser": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "postcss-angular": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "1.97.1",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-scss": "^7.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "^0.28.0"
  }
}
