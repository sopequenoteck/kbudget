# Budget — Caddy reverse proxy (VM separee)
# Remplacer VM_DOCKER_IP par l'IP reelle de la VM Docker

budget.kksdev.fr {
	# API Spring Boot
	handle /api/* {
		reverse_proxy VM_DOCKER_IP:3001
	}

	# Frontend Angular (container Nginx)
	handle {
		reverse_proxy VM_DOCKER_IP:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
