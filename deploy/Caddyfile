# K-Budget — Caddy reverse proxy (VM separee)

budget.kksdev.fr {
	# API Spring Boot
	handle /api/* {
		reverse_proxy 192.168.1.81:3001
	}

	# Frontend Angular (container Nginx)
	handle {
		reverse_proxy 192.168.1.81:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
