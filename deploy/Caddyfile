# Budget — Caddy reverse proxy + frontend
# En mode Docker : remplacer localhost:8080 par api:8080

budget.kksdev.fr {
	# API Spring Boot
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# Frontend Angular (fichiers statiques + SPA fallback)
	handle {
		root * /opt/budget-app/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
