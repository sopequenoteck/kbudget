[Unit]
Description=K-Budget API (Spring Boot)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=budget
Group=budget
WorkingDirectory=/opt/k-budget-api

ExecStart=/usr/bin/java -jar /opt/k-budget-api/api.jar --spring.profiles.active=prod
EnvironmentFile=/opt/k-budget-api/.env

Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/k-budget-api/logs

[Install]
WantedBy=multi-user.target
